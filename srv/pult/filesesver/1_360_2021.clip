#PROGRAM:
LOCAL sTmp
*? a003_
*1 первый параметр - Периодичность в секундах обновления информации, 60
*2 второй параметр - Количество строк на странице, 13
*3 третий параметр - Периодичность в секундах перезагрузки страницы, 10800
*4 третий параметр - Размер шрифта для HTML, 16
* Пример вызова
* http://tutmed.by/cgi-bin/is10_02?sSd_=0&sfil_n=126&svid_=5&sgr_l=40&stst_=0&sit_l=200&shead_=0&sadd_=60,10
/*
	svid_ - вид шаблона (поле Т070__01 шаблона выборки)
	sgr_l - номер группы шаблонов (поле Т070__02 шаблона выборки)
	sit_l - номер шаблона (поле Т070__03 шаблона выборки)
	stst_ - признак тестового запуска 0-нет, 1-да
	sadd_ - дополнительные атрибуты через запятую
	nAgain_ - номер окна, в котором выполняется выборка 1-левое, 3-правое

Дополнительные параметры:
	sSd_ - ='0' при вызове "гостем"
	nfil_n - номер филиалал при вызове "гостем"
*/

DO WHILE .T.
? AT0_001_(XP:PART[01])

	a000_[91] := 9 //количество строк на экране
	a000_[92] := 10*1000  // частота обновления экрана
	a000_[94] := 10800*1000  //частота обращения на сервер
	a000_[95] := 38  // размер основного шрифта
	a000_[96] := '314'  // номер филиала

	IF a000_[91] = 0 .OR. a000_[92] = 0 .OR. a000_[94] = 0 .OR. a000_[95] = 0
		sRet_ = 'Int.err 1'
		EXIT
	ENDIF
	
? AT0_001_(XP:PART[02])
? AT0_001_(XP:PART[03])
? AT0_001_(XP:PART[04])
	EXIT
ENDDO
		
	