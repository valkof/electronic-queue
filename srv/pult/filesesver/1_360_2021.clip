<script>
	function spinerStop() { 
		var pl = document.getElementById('page_load');
		var prepl = document.getElementById('pre_page_load');
		if (pl !== null && prepl !== null) {
		   pl.style.display = "none";
		   prepl.style.display = "none";
		   pl.classList.remove("loader"); 
		   prepl.classList.remove("pre_loader"); 
		}
	}
</script> 

