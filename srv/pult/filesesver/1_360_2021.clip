<script>
	async function getData() {
	  try {
		const response = await fetch('https://tutmed.by/cgi-bin/is10_09?sSd_=0&svid_=5&sgr_l=40&sit_l=211&stst_=0&shead_=0&style_=0&sfil_n=@D30009601TR&sadd_=1000,1000');
		
		if (!response.ok) {
		  throw new Error(`HTTP error! Status: ${response.status}`);
		}
		
		const data = await response.json();
		console.log('Данные:', data);
		spinerStop();
		mainLoop(data);
	  } catch (error) {
		console.error('Ошибка:', error);
	  }
	}
</script>
###
<script>
	const arrRows = [];
	
	function mainLoop(data) {
		
		const tableHeader = document.getElementById('table_header');
		const thCol1 = document.createElement('th');
		thCol1.textContent = 'участок';
		thCol1.classList.add('aBorder');
		thCol1.width = '18%'
		tableHeader.appendChild(thCol1);
		
		data['header'].forEach((item, i) => {
		  if (i > 7) return;
		  const th = document.createElement('th');
		  th.innerHTML = `${item}`;
		  th.classList.add('aBorder');
		  th.width = '7.5%'
		  tableHeader.appendChild(th);   
		})
		
		const table = document.getElementById('raspisanie');
		let nameGroup = '';
		let tdTable;
		let rowCount = 0;
		data['data'].forEach(element => {
		  if (rowCount >= @D3000916010 || rowCount == 0) {
			  rowCount = 0;
			  const rowTable = document.createElement('tr');
			  rowTable.remove();
			  arrRows.push(rowTable);
			  tdTable = document.createElement('td');
			  tdTable.colSpan = '14';
			  rowTable.appendChild(tdTable);
		  }
		  if (nameGroup != element[0] || rowCount == 0) {
			  nameGroup = element[0]
			  const divName = document.createElement('div');
			  divName.classList.add('name-group');
			  divName.innerHTML = nameGroup;
			  tdTable.appendChild(divName);
		  }
		  const divRow = document.createElement('div');
		  divRow.classList.add('rowDoctor');
		  const divCom = document.createElement('div');
		  divCom.classList.add('itemDoctor');
		  divCom.classList.add('itemComent');
		  divCom.innerHTML = element[1];
		  const divDoctor = document.createElement('div');
		  divDoctor.innerHTML = `<h99>${element[2]}</h99><h98>${element[3]}</h98>`;
		  divDoctor.classList.add('itemDoctor');
		  divRow.appendChild(divCom);
		  divRow.appendChild(divDoctor);
		  element.slice(4).forEach((item, i) => {
			  if (i > 7) return;
			  const divTd = document.createElement('div');
			  divTd.innerHTML = item;
			  divTd.classList.add('itemDoctor');
			  divTd.classList.add('itemDay');
			  divRow.appendChild(divTd);
		  })
		  tdTable.appendChild(divRow);
		  rowCount++;
		})
		if (arrRows.length == 1) {
			table.appendChild(arrRows[0]);
		} else if (arrRows.length > 1) {
			table.appendChild(arrRows[0]);
			window.setInterval(() => {
				const rowRemove = arrRows.shift();
				arrRows.push(rowRemove);
				rowRemove.remove();
				table.appendChild(arrRows[0]);
			},@D3000926010);
		}
	};
	
	const thTime = document.getElementById('thTime');
	window.setInterval(() => {
		const newDate = new Date();
		const newDay = newDate.toLocaleString('ru',{day: 'numeric', month: 'long', year: 'numeric'});
		const newTime = newDate.toLocaleString('ru',{hour: 'numeric', minute: 'numeric'});
		thTime.innerHTML = `${newDay} ${newTime}`;
	},5000);
	
	window.setTimeout(() => {
		jsa_031(1,360,1021,'_self')
	},@D3000946010);
	 
	getData();
</script>
