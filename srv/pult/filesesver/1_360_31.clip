{
	"stdout": {
###
		"ticketsCount":"@D3000340000",
###
		"queues":[
###
			{
			"id":"@D3000310000",
			"ticketsCount":"@D3000320000"
			}
###
			,
###
		],
###
		"message":"@D3000330000"
	},
	"stderr": "@D3000300000"
}
###

#PROGRAM:
LOCAL cSql, sTmp, aTmp_ := {}, sysOut := "", sysErr := "", sRet_ := "", sMes_ := "", sQueues_ :={}

?? 'Content-type: application/json; charset=UTF-8 '
*?? 'Content-type: application/json; charset=koi8-r '
? ''
?? 'Access-Control-Allow-Origin: * '
? ''
?? 'Access-Control-Allow-Headers: Content-type '
? ''
??'Access-Control-Allow-Methods: GET '
? ''
? ''

*? "количество отложенных талонов 1,360,31",a003_
* sfil_n - Филиал
* queues_ids - ID очередей

DO WHILE .T.
	sfil_n := CT6_209_(aPar_,"sfil_n")
	dd := SUBSTR(DTOS(DATE()),7,2)
	queues_ids := TRIM(CT6_209_(aPar_,"queues_ids"))
	month_id := CT6_209_(aPar_,"month_id")

? AT0_001_(XP:PART[01]) 	
	aTmp_ = {}
	
	sIdQueue_ := AT2_210_3(queues_ids,",")
	nLen_ := LEN(sIdQueue_)

	FOR nI_ = 1 TO nLen_
		AAdd(sQueues_, {sIdQueue_[nI_], 0}) 
	NEXT

	IF LEN(queues_ids) = 0
		a000_[34] := 0
	ELSE
		* выборка отложенных талонов
		cSql = "SELECT T134__06 FROM T234_" + sfil_n + " WHERE T134__01=" + month_id + " AND T134__14=" + dd + " AND T134__09=10 AND T134__02 IN (" + queues_ids + ") AND T134__98=0"
*? '<br>1=',cSql
		IF .NOT. CheckResult(CT12_209_(hPipe,cSql,aTmp_))
			sRet_ = 'Int.err 7 1'
			EXIT
		ENDIF
*? aTmp_
		IF EMPTY(aTmp_)
			a000_[34] := 0
		ELSE
			a000_[34] := LEN(aTmp_)
		ENDIF
	ENDIF
? AT0_001_(XP:PART[02])
		

	aTmp_ := {}
? AT0_001_(XP:PART[03])	
	IF LEN(queues_ids) != 0
		* выборка доступных талон в очередях
		cSql = "SELECT T134__02, COUNT(*) FROM T234_" + sfil_n + " WHERE T134__01=" + month_id + " AND T134__14=" + dd + " AND T134__09=1 AND T134__02 IN (" + queues_ids + ") AND T134__98=0 GROUP BY T134__02"
*? '<br>3=',cSql
		IF .NOT. CheckResult(CT12_209_(hPipe,cSql,aTmp_))
			sRet_ = 'Int.err 7 2'
			EXIT
		ENDIF
*? aTmp_

		nLen_ = LEN(aTmp_)
		nLen_1 := LEN(sQueues_)
		
		IF !EMPTY(aTmp_)
			FOR nI_ = 1 TO nLen_ STEP 2
				FOR nI_1 = 1 TO nLen_1
					IF aTmp_[nI_] == sQueues_[nI_1][1]
						sQueues_[nI_1][2] = aTmp_[nI_+1] 
					ENDIF
				NEXT
			NEXT
			
		ENDIF
	
		IF !EMPTY(sQueues_)
			FOR nI_1 = 1 TO nLen_1
				a000_[31] := sQueues_[nI_1][1]
				a000_[32] := sQueues_[nI_1][2]
? AT0_001_(XP:PART[04]) 
				IF nI_1 < nLen_1
? AT0_001_(XP:PART[05]) 
				ENDIF
			NEXT
		ENDIF
	ENDIF
? AT0_001_(XP:PART[06]) 



	EXIT
ENDDO

*? '<br>R=', sRet_
IF sRet_ == ""
	a000_[30] := CT3_010_(5, "")
	a000_[33] := CT3_010_(5, sMes_)
ELSE
	a000_[30] := CT3_010_(5, sRet_)
	a000_[33] := CT3_010_(5, "")
ENDIF
*?? CT3_010_(5,sfil_n)
? AT0_001_(XP:PART[07])
		
	